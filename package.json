{
  "name": "hsinspired",
  "version": "0.1.0",
  "description": "A Hearthstone-inspired card game built with Electron, TypeScript, and PixiJS",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run.cjs dev",
    "build": "node scripts/run.cjs build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise --validate .dependency-cruiser.cjs src",
    "architecture:map": "node scripts/generate-architecture-atlas.cjs",
    "architecture:focus": "node scripts/generate-architecture-atlas.cjs --focus",
    "architecture:check": "node scripts/verify-code-health.cjs",
    "build:smoke": "node scripts/build-smoke.cjs",
    "test": "vitest run",
    "perf:match": "node scripts/run-match-performance.cjs",
    "catalog:audit": "node scripts/catalog-audit.cjs",
    "verify": "npm run format:check && npm run lint && npm run test && npm run typecheck && npm run deps:check && npm run build:smoke",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^18.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
