{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/desktop/main/**/*",
    "src/desktop/preload/**/*",
    "src/game-rules/**/*",
    "src/desktop/contracts/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["assets/*"]
    }
  }
}
