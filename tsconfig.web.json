{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/game/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@assets/*": ["assets/*"],
      "@dev-inspector": ["src/renderer/scenes/dev/card-inspector-scene.ts"],
      "@dev-layout-inspector": ["src/renderer/features/dev/layout-inspector/index.ts"]
    }
  },
  "exclude": ["src/renderer/**/*.test.ts", "src/game/**/*.test.ts"]
}
