{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/env.d.ts",
    "src/renderer/**/*",
    "src/game/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/*"],
      "@assets/*": ["assets/*"],
      "@dev-inspector": ["src/renderer/scenes/dev/card-inspector-scene.ts"],
      "@outline-lab": ["src/renderer/scenes/dev/outline-lab-scene.ts"],
      "@hero-power-anim": ["src/renderer/scenes/dev/hero-power-anim-scene.ts"],
      "@vfx-lab": ["src/renderer/scenes/dev/vfx-lab-scene.ts"],
      "@dev-match-performance": ["src/renderer/app/dev-match-performance.ts"],
      "@dev-layout-inspector": ["src/renderer/features/dev/layout-inspector/index.ts"],
      "@outline-directions": [
        "src/renderer/rendering/effects/outline-directions-dev.ts"
      ]
    }
  }
}
