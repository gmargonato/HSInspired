{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/game/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@assets/*": ["assets/*"],
      "@dev-inspector": ["src/renderer/src/scenes/dev/CardInspectorScene.ts"],
      "@dev-layout-inspector": [
        "src/renderer/src/features/dev/layout-inspector/index.ts"
      ]
    }
  },
  "exclude": ["src/renderer/**/*.test.ts", "src/game/**/*.test.ts"]
}
